@echo off
@title PW Auto Login
chcp 65001 >nul
setlocal
::::::::::::::::::::::::::::::::::::::::::::::::::::
::                 PW 自动登录                    ::
::        作者: Diogo Santos Pombo \Õ/           ::
:: 请按照脚本中的注释进行配置！                   ::
:::::::::::::::::::::::::::::::::::::::::::::::::


::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: 脚本配置:                                                                                            ::
:: 注意: 此脚本/文件必须与游戏的可执行文件 (.exe) 位于同一文件夹中才能正常运行！                           ::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::


:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: 在 = 号后输入游戏的可执行文件 (.exe) 名称                                  ::
:: 只需输入文件名和扩展名，不需要完整路径！                                   ::
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
set executable=


:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: 在 = 号后输入您的登录账号                                    ::
:: 不用担心，脚本不会在屏幕上显示您的账号！                      ::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
set user=


:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: 在 = 号后输入您的密码                                        ::
:: 不用担心，脚本不会在屏幕上显示您的密码！                      ::
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
set password=


:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: 可选! 在 = 号后输入您在游戏中的角色名                                                                            ::
:: 这将自动选择角色。留空则只进行自动登录而不选择角色！                                                              ::
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
set nickname=


:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: 在 = 号后输入游戏中的服务器名称                                            ::
:: 这将自动选择服务器！                                                      ::
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
set server=

























































































































































































































































































































































































































































































































































































































































































































































































































































:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: 注意: 请不要修改此行以下的脚本，以避免出现错误！                           ::
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::


cls
color 0b
set header=**************************************** PW 自动登录 ****************************************
echo.
echo.
echo    %header%
echo.
echo.
echo 注意: 此脚本必须事先配置好才能正常运行！
echo.
if "%server%"=="" (
    echo 请稍候，正在启动 Perfect World 并自动登录. . .
) else (
    echo 请稍候，正在启动 Perfect World 并自动登录到服务器 %server%. . .
)
echo.

if "%nickname%"=="" (
   goto nonickname
) else (
   goto withnickname
)


:nonickname
echo.
start %executable% startbypatcher user:%user% pwd:%password% area:%server%
if not %errorlevel%==0 (
    goto error
)
goto success

:withnickname
echo.
echo.
start %executable% startbypatcher user:%user% pwd:%password% role:%nickname% area:%server%
if not %errorlevel%==0 (
    goto error
)
goto success


:success
color 0a
echo.
echo Perfect World 自动登录已成功启动！


:end
endlocal
exit


:error
color 0c
echo.
echo 错误: 启动 %executable% 失败！
echo.
echo 可能的原因:
echo   - 脚本不在游戏可执行文件 (.exe) 的同一文件夹中！
echo   - 游戏可执行文件 (.exe) 不存在或已损坏！
echo   - 当前 Windows 用户没有访问游戏可执行文件 (.exe) 的权限！
echo   - 脚本未正确配置！
echo.
pause
goto end
